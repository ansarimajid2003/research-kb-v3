# Service-to-service connections used inside docker-compose.example.yml.
QDRANT_HOST=qdrant
QDRANT_PORT=6333
PG_DSN=postgresql://kb:change-me@postgres:5432/kb
POSTGRES_PASSWORD=change-me

# Required to access the HTTP MCP endpoint. Generate a long random value.
MCP_API_KEY=replace-with-a-long-random-secret

# Server paths; adjust them for the host that stores the private corpus.
ARXIV_DB=/data/arxiv_index.db
PAPERS_ROOT=/data/papers
MODELS_DIR=/kb/models
FORCE_FP16=true
